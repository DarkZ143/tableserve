rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isMenuManager(rid) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/restaurants/$(rid)/staff/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/restaurants/$(rid)/staff/$(request.auth.uid)).data.isActive == true
        && firestore.get(/databases/(default)/documents/restaurants/$(rid)/staff/$(request.auth.uid)).data.role in ['owner', 'manager']
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/memberships/$(rid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)/memberships/$(rid)).data.isActive == true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)/memberships/$(rid)).data.role == firestore.get(/databases/(default)/documents/restaurants/$(rid)/staff/$(request.auth.uid)).data.role;
    }

    match /restaurants/{rid}/menu/{fileName} {
      allow read: if true;
      allow create, update: if isMenuManager(rid)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isMenuManager(rid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
